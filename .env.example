HF_TOKEN=
HF_CLOUD_INFERENCE_ENABLED=true
HF_MAX_REQUESTS_PER_SESSION=20
HF_MAX_REQUESTS_PER_DAY=50
HF_MAX_REQUESTS_PER_MONTH=100
HF_MAX_CONCURRENT_REQUESTS=1
HF_MAX_PROVIDER_RETRIES=1
HF_REQUEST_COOLDOWN_MS=5000
HF_MAX_FRAMES_PER_REQUEST=6
HF_MAX_WINDOW_MS=4000
HF_MAX_FRAME_WIDTH=768
HF_MAX_FRAME_HEIGHT=768
HF_MAX_REQUEST_BODY_BYTES=5000000
HF_USAGE_STATE_PATH=.darkquest/hf-usage.json
MOVEMENT_RECOGNITION_PROVIDER=huggingface
MOVEMENT_RECOGNITION_MODEL=google/gemma-4-31B-it:cerebras
MOVEMENT_RECOGNITION_MODE=vlm_frames
MOVEMENT_RECOGNITION_MAX_FRAMES=4
MOVEMENT_RECOGNITION_WINDOW_MS=1500

# DarkQuest v2 local visual companion.
# Public SmolVLM2 does not require HF_TOKEN unless you switch to a gated model.
VISUAL_COMPANION_URL=http://127.0.0.1:8766
VISUAL_COMPANION_MODEL=HuggingFaceTB/SmolVLM2-2.2B-Instruct
VISUAL_COMPANION_MODEL_REVISION=main
VISUAL_COMPANION_MODE=local_smolvlm_frames
VISUAL_COMPANION_MAX_FRAMES=6
VISUAL_COMPANION_WINDOW_MS=2600
VISUAL_COMPANION_MODEL_DIR=.models/visual-companion/smolvlm2-2.2b-instruct

# Sensefield local voice. No API key or paid network speech provider is used.
SENSEFIELD_VOICE_MODEL=kokoro_82m
SENSEFIELD_VOICE_DEFAULT=sensefield_default
SENSEFIELD_VOICE_STYLE=warm_conversational
SENSEFIELD_VOICE_URL=http://127.0.0.1:8766
SENSEFIELD_VOICE_DEVICE=cpu
